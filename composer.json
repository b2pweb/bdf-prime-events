{
    "name": "b2pweb/bdf-prime-events",
    "description": "Prime library for listen MySQL events from replication protocol",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Vincent",
            "email": "vquatrevieux@b2pweb.com"
        }
    ],
    "minimum-stability": "dev",
    "autoload": {
        "psr-4": {
            "Bdf\\PrimeEvents\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\PrimeEvents\\": "tests/"
        }
    },
    "require": {
        "php": "~8.4.0 | ~8.5.0",
        "b2pweb/bdf-prime": "~2.0|~3.0",
        "krowinski/php-mysql-replication": "~8.1|~11.1",
        "psr/simple-cache": "~1.0|~2.0|~3.0"
    },
    "require-dev": {
        "ext-pcntl": "*",
        "phpunit/phpunit": "~13.4",
        "symfony/framework-bundle": "~5.4|~6.0|~7.0",
        "symfony/yaml": "~5.4|~6.0|~7.0",
        "symfony/console": "~5.4|~6.0|~7.0",
        "b2pweb/bdf-prime-bundle": "dev-feature-FRAM-233-prime-v3 as 1.11.0",
        "vimeo/psalm": "~6.0",
        "squizlabs/php_codesniffer": "~3.0"
    },
    "scripts": {
        "tests": "phpunit",
        "tests-with-coverage": "phpunit --coverage-clover coverage.xml",
        "psalm": "psalm --shepherd",
        "phpcs": "phpcs --standard=psr12 --tab-width=4 -n src/"
    }
}
